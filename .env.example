# Khoá API Anthropic (bắt buộc) - lấy tại https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Cổng chạy máy chủ
PORT=3000

# Mô hình Claude (mặc định claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Mức suy luận: low | medium | high (low = phản hồi nhanh hơn, phù hợp giọng nói)
CHAT_EFFORT=low
VISION_EFFORT=medium

# Giới hạn số yêu cầu / phút / địa chỉ IP (chống lạm dụng chi phí API)
RATE_LIMIT_PER_MIN=20
