# Khoá API Anthropic (bắt buộc) - lấy tại https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Cổng chạy máy chủ
PORT=3000

# Mô hình Claude (mặc định claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Mức suy luận: low | medium | high (low = phản hồi nhanh hơn, phù hợp giọng nói)
CHAT_EFFORT=low
VISION_EFFORT=medium

# Giới hạn số yêu cầu / phút / địa chỉ IP (chống lạm dụng chi phí API)
RATE_LIMIT_PER_MIN=20

# Tìm kiếm web cho câu hỏi cần thông tin mới (thời tiết, tin tức...). Đặt false để tắt.
ENABLE_WEB_SEARCH=true

# Mã truy cập (tuỳ chọn). Nếu đặt, chỉ ai mở link dạng https://.../?code=MA_CUA_BAN mới dùng được.
# Nên đặt khi đưa app lên Internet để tránh người lạ làm phát sinh chi phí API.
APP_ACCESS_CODE=
